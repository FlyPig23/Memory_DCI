# Only source code, protocols, source references and documentation belong on GitHub.
.DS_Store
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.venv-*/
node_modules/
.env
.env.*
*.pem
*.key
auth.json
*.log
*.jsonl
/tmp/
archive/

# Dataset namespaces. Never commit downloaded inputs, runs, credentials or caches.
experiment/benchmarks/*
!experiment/benchmarks/wildclaw_bench/
!experiment/benchmarks/terminal_bench_2_1/
experiment/benchmarks/*/runtime/
experiment/benchmarks/*/runs/
experiment/benchmarks/*/logs/
experiment/benchmarks/*/prepared/
experiment/benchmarks/*/data/
experiment/benchmarks/*/.downloads/
experiment/benchmarks/*/corpus/
experiment/benchmarks/*/vendor/
experiment/benchmarks/*/trajectory library/
experiment/benchmarks/*/skills/
experiment/benchmarks/*/evidence/
experiment/benchmarks/*/variants/*/prepared/
experiment/benchmarks/terminal_bench_2_1/manifests/
experiment/benchmarks/terminal_bench_2_1/reports/
experiment/benchmarks/wildclaw_bench/reports/**/*.json
experiment/benchmarks/wildclaw_bench/reports/**/*.csv
experiment/benchmarks/wildclaw_bench/reports/**/*.html
experiment/benchmarks/wildclaw_bench/reports/versions.json
experiment/benchmarks/wildclaw_bench/manifests/*
!experiment/benchmarks/wildclaw_bench/manifests/formal_protocol.json
!experiment/benchmarks/wildclaw_bench/manifests/runtime_skill_patches.json
