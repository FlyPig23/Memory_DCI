!experiment/benchmarks/wildclaw_bench/manifests/warmup_dependencies.json
!experiment/benchmarks/wildclaw_bench/manifests/workflow_config.json
# Temporary local compatibility paths used by already-running services.
experiment/src/
experiment/scripts/
experiment/runtime/
experiment/.venv/
experiment/.venv-dependencies/
experiment/LOCAL_COMPATIBILITY.md
# Local-only tool harness; preserved separately from dataset experiments.
pi_harness/
.cache/
.openai/
docs/project_map/
docs/meeting_notes/v5_html/
papers/*.pdf
reports/*.html
